# Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority

# JWT Configuration (generate a secure random string)
JWT_SECRET=your-super-secure-jwt-secret-key-here-min-32-chars

# Razorpay Configuration (Required for payment processing)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
# Optional: separate public key (defaults to KEY_ID if not provided)
RAZORPAY_KEY_ID_PUBLIC=rzp_test_your_public_key_here

# Twilio Configuration (for SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SERVICE_SID=your_twilio_verify_service_sid

# Cyrus Recharge API Configuration
CYRUS_BASE_URL=https://cyrusrecharge.in/Root/API
CYRUS_MEMBER_ID=your_cyrus_member_id
CYRUS_API_KEY=your_cyrus_api_key

# Development OTP (only for testing, remove in production)
DEV_STATIC_OTP=123456

# CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:8080,https://your-domain.com